/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */
  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */
  // Remap 반드시 TIM Init 이전에 실행
  __HAL_AFIO_REMAP_SWJ_NOJTAG();        // PA15 JTAG 해제
  __HAL_AFIO_REMAP_TIM2_PARTIAL_1();    // PA15/PB3 → TIM2
  __HAL_AFIO_REMAP_TIM3_PARTIAL();      // PB4/PB5  → TIM3
  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_TIM1_Init();
  MX_TIM2_Init();
  MX_TIM3_Init();
  MX_TIM4_Init();
  MX_USART3_UART_Init();
  /* USER CODE BEGIN 2 */

  // 엔코더 타이머 4개 시작
  HAL_TIM_Encoder_Start(&htim1, TIM_CHANNEL_ALL);
  HAL_TIM_Encoder_Start(&htim2, TIM_CHANNEL_ALL);
  HAL_TIM_Encoder_Start(&htim3, TIM_CHANNEL_ALL);
  HAL_TIM_Encoder_Start(&htim4, TIM_CHANNEL_ALL);

  // PWM 시작
  HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_3);
  HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_4);

  // FL 모터 앞으로 50%
  HAL_GPIO_WritePin(GPIOA, FL_IN1_Pin, GPIO_PIN_SET);
  HAL_GPIO_WritePin(GPIOA, FL_IN2_Pin, GPIO_PIN_RESET);
  __HAL_TIM_SET_COMPARE(&htim4, TIM_CHANNEL_3, 1800);

  // FR 모터 앞으로 50%
  HAL_GPIO_WritePin(GPIOA, FR_IN3_Pin, GPIO_PIN_SET);
  HAL_GPIO_WritePin(GPIOA, FR_IN4_Pin, GPIO_PIN_RESET);
  __HAL_TIM_SET_COMPARE(&htim4, TIM_CHANNEL_4, 1800);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

  enc_fl = (int32_t)__HAL_TIM_GET_COUNTER(&htim1);

  // 오버플로우 처리
  int32_t delta = enc_fl - enc_fl_prev;

  if (delta > 32767)        // 양방향 오버플로우
      delta -= 65536;
  else if (delta < -32768)
      delta += 65536;

  // RPM 계산
  // 44 = 11PPR × 4체배
  // 600 = 60초 / 0.1초(100ms)
  rpm_fl = ((float)delta / 44.0f) * 600.0f;

  enc_fl_prev = enc_fl;

  printf("RPM: %.1f\r\n", rpm_fl);

  HAL_Delay(100);
  /* USER CODE END 3 */
  }
}

